server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: serve index.html for any non-file route
    location / {
        try_files $uri /index.html;
    }

    # Reverse proxy /api/* to backend, stripping the /api prefix
    # e.g. /api/health -> http://backend:3000/health
    # BACKEND_UPSTREAM is substituted by the nginx:stable entrypoint's
    # envsubst-on-templates step (this file lives at /etc/nginx/templates/
    # default.conf.template in the image); default value baked into the
    # image via ENV BACKEND_UPSTREAM=backend:3000 in frontend/Dockerfile,
    # overridable at deploy time (e.g. Zeabur's <service>.zeabur.internal).
    location /api/ {
        proxy_pass http://$BACKEND_UPSTREAM/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
