# =============================================================================
# .env.example — Environment variable template
# Copy to .env and fill in real values. .env is NOT committed to version control.
# All values here are placeholders — never commit real secrets.
# See docs/specs/PHASE-001.md §6 for the authoritative variable list.
# =============================================================================

# ── Backend ──────────────────────────────────────────────────────────────────

# Node environment (development | production | test)
NODE_ENV=development

# Backend listening port (default 3000; nginx proxies /api → backend:3000)
PORT=3000

# PostgreSQL connection string (required — backend fails to start without this)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://appuser:changeme@db:5432/appdb

# Path for file/attachment storage volume mount (reserved; not used in PHASE-001)
STORAGE_PATH=/data/storage

# ── Attachment storage (PHASE-003-T2) ────────────────────────────────────────

# Absolute path to the persistent volume where attachment files are stored.
# In Docker Compose / Zeabur: set to the volume mount point (e.g. /data/attachments).
# In local development / tests: set to a writable temp directory.
# No default — must be provided in production; tests use a synthetic temp dir.
ATTACHMENT_STORAGE_ROOT=/data/attachments

# Single-file upload size limit in bytes (default 10 MiB = 10485760)
ATTACHMENT_MAX_BYTES=10485760

# Temp attachment cleanup threshold in hours (default 24)
# Attachments in TEMP status older than this are eligible for cleanup (PHASE-011 scheduler).
ATTACHMENT_TEMP_TTL_HOURS=24

# Thumbnail long-side pixel limit (used if sharp is enabled; default 512)
ATTACHMENT_THUMBNAIL_MAX_PX=512

# Pino log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ── Frontend (dev only) ───────────────────────────────────────────────────────

# Vite dev server proxy target for /api routes (development only; nginx handles prod)
VITE_API_PROXY_TARGET=http://localhost:3000

# ── Database (docker compose only) ───────────────────────────────────────────

# PostgreSQL container initialisation credentials
# These are used by the postgres:16 image to create the initial database.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
