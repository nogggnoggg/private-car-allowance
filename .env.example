# =============================================================================
# .env.example — Environment variable template
# Copy to .env and fill in real values. .env is NOT committed to version control.
# All values here are placeholders — never commit real secrets.
# See docs/specs/PHASE-001.md §6 for the authoritative variable list.
# =============================================================================

# ── Backend ──────────────────────────────────────────────────────────────────

# Node environment (development | production | test)
NODE_ENV=development

# Backend listening port (default 3000; nginx proxies /api → backend:3000)
PORT=3000

# PostgreSQL connection string (required — backend fails to start without this)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://appuser:changeme@db:5432/appdb

# Path for file/attachment storage volume mount (reserved; not used in PHASE-001)
STORAGE_PATH=/data/storage

# ── Session & login lockout (PHASE-002) ──────────────────────────────────────

# Session absolute expiry in hours (default 8). Sessions are cut off at this age
# regardless of activity; there is no sliding renewal.
SESSION_ABSOLUTE_TTL_HOURS=8

# Session cookie name (default "sid"). PHASE-011 §16 D7=(a): no __Host-/__Secure-
# prefix is used — changing this to a prefixed name would silently break the
# development environment (prefixes require Secure, which dev does not set).
SESSION_COOKIE_NAME=sid

# Consecutive failed logins before the account is locked out (default 5)
LOGIN_MAX_FAILURES=5

# Lockout duration in minutes once LOGIN_MAX_FAILURES is reached (default 15)
LOGIN_LOCK_MINUTES=15

# ── Attachment storage (PHASE-003-T2 / T8) ───────────────────────────────────

# Absolute path to the persistent volume where attachment files are stored.
# In Docker Compose: compose default is /data/storage/attachments (sub-path of the
#   storage named volume; see docker-compose.yml ATTACHMENT_STORAGE_ROOT env entry).
#   The storage volume is mounted at STORAGE_PATH (/data/storage), and attachments
#   live under /data/storage/attachments — isolating them from the future PDF prefix
#   (/data/storage/pdf, PHASE-008) per D4 prefix-isolation decision.
# In local development / tests: set to a writable temp directory.
# No default — must be provided in production; tests use a synthetic temp dir.
ATTACHMENT_STORAGE_ROOT=/data/storage/attachments

# Single-file upload size limit in bytes (default 10 MiB = 10485760)
ATTACHMENT_MAX_BYTES=10485760

# Temp attachment cleanup threshold in hours (default 24)
# Attachments in TEMP status older than this are eligible for cleanup (PHASE-011 scheduler).
ATTACHMENT_TEMP_TTL_HOURS=24

# Thumbnail long-side pixel limit (used if sharp is enabled; default 512)
ATTACHMENT_THUMBNAIL_MAX_PX=512

# Max attachments deleted per cleanup run (default 500; PHASE-011-T4, must be > 0).
# Read ONLY by the one-shot CLI `attachment/cleanup-cli.ts` — the server process
# neither reads nor schedules it. An invalid value makes the CLI exit non-zero
# WITHOUT deleting anything (fail-closed), it does not silently fall back.
ATTACHMENT_CLEANUP_BATCH_LIMIT=500

# ── Report PDF storage (PHASE-008-T7/T7b/T8) ─────────────────────────────────

# Absolute path to the persistent volume where generated PDF reports are stored.
# In Docker Compose: compose default is /data/storage/pdf (sub-path of the same
#   storage named volume as ATTACHMENT_STORAGE_ROOT, isolated under its own
#   `rpt/` key prefix — never shared with attachment storage keys).
# In local development / tests: set to a writable temp directory.
# No default — must be provided in production; tests use a synthetic temp dir.
REPORT_STORAGE_ROOT=/data/storage/pdf

# Playwright PDF render timeout in milliseconds (default 30000)
REPORT_PDF_TIMEOUT_MS=30000

# Report image embed long-edge pixel cap (default 1600; not enlarged if smaller)
REPORT_IMAGE_MAX_PX=1600

# Pino log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ── Frontend (dev only) ───────────────────────────────────────────────────────

# Vite dev server proxy target for /api routes (development only; nginx handles prod)
VITE_API_PROXY_TARGET=http://localhost:3000

# ── Database (docker compose only) ───────────────────────────────────────────

# PostgreSQL container initialisation credentials
# These are used by the postgres:16 image to create the initial database.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
