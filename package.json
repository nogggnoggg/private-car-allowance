{
  "name": "oil-expense-root",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
