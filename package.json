    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "argon2@0.45.1": true
  }
}
