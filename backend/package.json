{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "seed:admin": "node dist/seed/seed-admin.js",
    "seed:admin:dev": "tsx src/seed/seed-admin.ts",
    "cleanup:attachments": "node dist/attachment/cleanup-cli.js",
    "cleanup:attachments:dev": "tsx src/attachment/cleanup-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "playwright": "^1.62.1",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
