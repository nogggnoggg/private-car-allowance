// Prisma schema — datasource + generator + minimal HealthProbe model
// See PHASE-001 Spec §7 for migration strategy
// PHASE-002: User / Session / AuditLog added per §3 (model layer finalized)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Minimal model used only to verify migration mechanism and data persistence (AC-04).
/// Not a business model — see PHASE-001 Spec §7.
model HealthProbe {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PHASE-002 enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum AuditAction {
  USER_CREATED
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_PASSWORD_RESET
  USER_DELETED
  PARAMETER_VERSION_CREATED
  APPLICATION_CREATED_ON_BEHALF
  APPLICATION_UPDATED_ON_BEHALF
  USER_FUEL_CONSUMPTION_VERSION_CREATED // PHASE-005a-T1（§8.1）
  APPLICATION_VOIDED // PHASE-009-T1（§8.1／D10(a)）
}

// ---------------------------------------------------------------------------
// PHASE-002 models
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  loginName          String    @unique // 登入帳號，唯一
  displayName        String // 顯示姓名
  employeeNumber     String? // 員工編號，可空
  passwordHash       String // 僅存不可逆雜湊（argon2id 編碼字串，含參數+salt）
  role               Role      @default(USER)
  isActive           Boolean   @default(true) // 啟用/停用
  mustChangePassword Boolean   @default(true) // 首次登入/重設後強制改密旗標
  failedLoginCount   Int       @default(0) // 連續登入失敗計數
  lockedUntil        DateTime? // 鎖定至（null=未鎖定；未來時間=鎖定中）
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions               Session[]
  auditLogsAsActor       AuditLog[]   @relation("AuditActor")
  auditLogsAsTarget      AuditLog[]   @relation("AuditTarget")
  attachmentsAsUploader  Attachment[] @relation("AttachmentUploader")
  attachmentsAsOwner     Attachment[] @relation("AttachmentOwner")
  applicationsAsOwner    Application[] @relation("ApplicationOwner")
  applicationsAsCreator  Application[] @relation("ApplicationCreatedBy")
  fuelConsumptionVersions UserFuelConsumptionVersion[] @relation("UserFuelConsumption")

  @@index([loginName])
}

model Session {
  id                 String    @id @default(cuid()) // 內部主鍵
  sessionToken       String    @unique // 高熵隨機 token（見 4.3；存雜湊，見下）
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime // 絕對到期
  lastSeenAt         DateTime  @default(now()) // 滑動更新用
  revokedAt          DateTime? // 失效標記（登出/停用/重設密碼即設）
  mustChangePassword Boolean   @default(false) // 建立時快照使用者強制改密狀態（見 4.7.1）

  @@index([userId])
  @@index([sessionToken])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  actorId     String // 操作者（管理員）
  actor       User        @relation("AuditActor", fields: [actorId], references: [id])
  targetId    String? // 受影響使用者（刪除後可能為 null）
  target      User?       @relation("AuditTarget", fields: [targetId], references: [id])
  targetLabel String // 受影響資料可讀摘要（如 loginName 快照），供刪除後仍可辨識
  summary     Json? // 前後重要欄位摘要（絕不含密碼；見 4.7）
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PHASE-003a models
// ---------------------------------------------------------------------------

/// 油資每公里單價版本（FuelParameterVersion）。
/// D1: 三表結構（型別安全）；D2: 僅 effectiveFrom（日粒度，隱含結束）；D8: unitPrice Decimal(10,4)。
model FuelParameterVersion {
  id            String   @id @default(cuid())
  unitPrice     Decimal  @db.Decimal(10, 4) // 油資每公里單價，≥0；D8 精度
  effectiveFrom DateTime @db.Date // 生效日（日粒度，含當日）；@db.Date 不含時間
  createdById   String // 建立之管理員 id（稽核追溯；無外鍵，見 T1 Packet 說明）
  createdAt     DateTime @default(now())

  @@unique([effectiveFrom]) // D4 併發防線：同類同生效日唯一
  @@index([effectiveFrom])
}

/// ETC 每公里單價版本（EtcParameterVersion）。
/// 結構同 FuelParameterVersion；D8: unitPrice Decimal(10,4)。
model EtcParameterVersion {
  id            String   @id @default(cuid())
  unitPrice     Decimal  @db.Decimal(10, 4) // ETC 每公里單價，≥0；D8 精度
  effectiveFrom DateTime @db.Date
  createdById   String
  createdAt     DateTime @default(now())

  @@unique([effectiveFrom]) // D4 併發防線
  @@index([effectiveFrom])
}

/// 折舊參數版本（DepreciationParameterVersion）。
/// D7: 派生值（每年費用/每公里單價）不持久化，即算即回；D8: vehiclePrice Decimal(12,2)、年限/年里程 Int。
model DepreciationParameterVersion {
  id                String   @id @default(cuid())
  vehiclePrice      Decimal  @db.Decimal(12, 2) // 車價（新臺幣），>0；D8 精度
  usefulLifeYears   Int // 折舊年限（年），>0；整數（D8）
  estimatedAnnualKm Int? // 修訂段 §20.7.1／D21：NOT NULL → NULLABLE（凍結欄；新版本恆 null，歷史列原值保留）
  effectiveFrom     DateTime @db.Date
  createdById       String
  createdAt         DateTime @default(now())
  // 注：每年折舊費用與每公里單價「不持久化」（D7），由推導引擎即算即回。

  @@unique([effectiveFrom]) // D4 併發防線
  @@index([effectiveFrom])
}

// ---------------------------------------------------------------------------
// PHASE-003 enums
// ---------------------------------------------------------------------------

/// Attachment lifecycle state. LOCKED is not a persistent enum value —
/// immutability is determined by the owning container's completion status (D2).
enum AttachmentStatus {
  TEMP   // Uploaded but not yet associated with any application
  LINKED // Associated with a draft container
}

/// Weak-reference type for the owning container (D1: no FK to non-existent tables).
/// Concrete tables are created in PHASE-004/006/007.
enum AttachmentRefType {
  TRIP_SEGMENT // Travel trip segment (PHASE-004)
  MAINTENANCE  // Maintenance application (PHASE-006)
  DEPRECIATION // Depreciation application (PHASE-007)
}

// ---------------------------------------------------------------------------
// PHASE-003 models
// ---------------------------------------------------------------------------

/// Attachment — general-purpose file attachment model, shared by all application types.
/// Spec §3.1 (PHASE-003). storageKey uses system-generated keys; no user input in paths.
model Attachment {
  id     String           @id @default(cuid())
  status AttachmentStatus @default(TEMP)

  // Storage references (storage abstraction layer keys — not absolute container paths)
  storageKey       String  @unique // Original file key in storage
  thumbnailKey     String? // Thumbnail key (set after successful thumbnail generation)
  mimeType         String // Detected MIME type: image/jpeg | image/png | image/webp
  byteSize         Int // Actual byte count
  originalFilename String // User-provided filename for display only; never used in path

  // Uploader and owner (authorization basis; D3: ownerId=uploaderId in this Phase)
  uploaderId String // User who performed the upload (may be admin acting on behalf)
  uploader   User   @relation("AttachmentUploader", fields: [uploaderId], references: [id])
  ownerId    String // Data owner (authorization checks use this; immutable after creation)
  owner      User   @relation("AttachmentOwner", fields: [ownerId], references: [id])

  // Weak reference to owning container (D1: no FK — target tables do not exist yet)
  refType AttachmentRefType? // Container type; required when status=LINKED
  refId   String? // Container id (e.g. TripSegment id); required when status=LINKED

  createdAt DateTime  @default(now()) // Upload time (TEMP TTL baseline)
  linkedAt  DateTime? // Time when status transitioned to LINKED
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([refType, refId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PHASE-005a enums / models（§8.1/§8.2）
// ---------------------------------------------------------------------------

/// 固定四項油種（Q4），不提供自訂；zh-TW 標籤由前端映射，不入 DB（D2）。
enum FuelType {
  GASOLINE_92
  GASOLINE_95
  GASOLINE_98
  DIESEL
}

/// PHASE-005a：按油種之每公升油價版本。取代 FuelParameterVersion 之油資角色（D1）。
model FuelPriceVersion {
  id            String   @id @default(cuid())
  fuelType      FuelType
  pricePerLiter Decimal  @db.Decimal(10, 4) // 元／公升，≥0；沿用 UNIT_PRICE_CAPACITY
  effectiveFrom DateTime @db.Date // 日粒度，含當日
  createdById   String // 建立之管理員 id（無 FK，沿用 003a 慣例）
  createdAt     DateTime @default(now())

  @@unique([fuelType, effectiveFrom]) // Q1：每油種各自一條時間軸；併發最後防線
  @@index([fuelType, effectiveFrom])
}

/// PHASE-005a：按使用者之車輛油種與油耗版本。僅管理員可寫（AD-US-15）。
/// onDelete: Restrict — AD-US-04「有歷史資料之帳號拒絕永久刪除」之既有語意延伸；
/// `userHasHistory`（backend/src/users/history.ts）須同步納入本表（T1 Done When）。
model UserFuelConsumptionVersion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserFuelConsumption", fields: [userId], references: [id], onDelete: Restrict)
  fuelType      FuelType
  kmPerLiter    Decimal  @db.Decimal(10, 4) // km/L，>0（容量見 D3(b)）
  effectiveFrom DateTime @db.Date
  basisNote     String // 必填核對依據（Q6；長度上限見 D3(c)）
  createdById   String // 操作管理員 id
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom]) // 同使用者不重疊；跨使用者互不干涉
  @@index([userId, effectiveFrom])
}

// ---------------------------------------------------------------------------
// PHASE-004 models
// ---------------------------------------------------------------------------

// ── PHASE-004 enums ────────────────────────────────────────────────
enum ApplicationType {
  TRAVEL
  MAINTENANCE   // 宣告以供查詢相容；子表於 PHASE-006 建立
  DEPRECIATION  // 宣告以供查詢相容；子表於 PHASE-007 建立
}

enum ApplicationStatus {
  DRAFT
  COMPLETED
  VOIDED        // 宣告（供 PHASE-005 過濾條件可寫）；本 Phase 無任何轉換路徑（AC-58）
}

// AuditAction 擴充（既有 enum 追加值）
//   APPLICATION_CREATED_ON_BEHALF
//   APPLICATION_UPDATED_ON_BEHALF

// ── 共用父表 ────────────────────────────────────────────────────────
model Application {
  id          String            @id @default(cuid())
  type        ApplicationType
  status      ApplicationStatus @default(DRAFT)

  ownerId     String                                     // 資料擁有人（授權權威）
  owner       User @relation("ApplicationOwner",     fields: [ownerId],     references: [id], onDelete: Restrict)
  createdById String                                     // 實際操作者（代操作時為管理員）
  createdBy   User @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// 列表排序與期間篩選之歸屬日期（D9）：差旅＝出差日期；未填時暫以建立日期代之。
  /// 非統計權威——PHASE-005 統計一律讀 TravelApplication.tripDate（已完成必非空）。
  primaryDate DateTime @db.Date

  /// 完成快照：最終申報金額（新臺幣整數）。草稿為 null（AC-07/50）。
  totalAmount Int?
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// PHASE-009：作廢資訊（三欄同生共死——恆同時為 null 或同時非 null）
  voidReason  String? // trim 後 1..500（應用層驗證）
  voidedAt    DateTime?
  voidedById  String? // 操作者（無 FK，沿 Report.generatedById 慣例）

  /// PHASE-009：版本關聯——本列為「哪一筆已完成申請」之修正版（D7：0..1）
  supersedesId String? @unique
  supersedes   Application?  @relation("ApplicationRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Application?  @relation("ApplicationRevision")

  travel       TravelApplication?
  maintenance  MaintenanceApplication?
  depreciation DepreciationApplication?
  report       Report?

  @@index([ownerId, status, primaryDate])
  @@index([ownerId, primaryDate])
  @@index([type, status])
  @@index([primaryDate])
}

// ── 差旅子表（1:1） ─────────────────────────────────────────────────
model TravelApplication {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  tripDate DateTime? @db.Date   // 出差日期（日粒度，含當日；歸屬期間與年度之權威）
  purpose  String?              // 出差目的（關鍵字查詢對象）

  // ── 完成快照（BE-US-18）；一經寫入不可變 ──
  fuelUnitPrice          Decimal? @db.Decimal(10, 4)  // 快照單價，與 PHASE-003a D8 精度一致
  etcUnitPrice           Decimal? @db.Decimal(10, 4)
  fuelParameterVersionId String?                      // 引用保護來源（AC-93）
  etcParameterVersionId  String?
  snapshotTotalKm        Decimal? @db.Decimal(12, 2)  // Σ 各段 totalKm（高速不重複加）
  snapshotRawAmount      Decimal? @db.Decimal(14, 4)  // Σ 各段取整前金額
  calculatedAt           DateTime?

  // ── PHASE-005a 新增（§8.3；全部 nullable，無 default，零回填）──
  snapshotFuelType          FuelType?
  snapshotFuelPricePerLiter Decimal?  @db.Decimal(10, 4)
  snapshotFuelConsumption   Decimal?  @db.Decimal(10, 4)
  fuelPriceVersionId        String?
  fuelConsumptionVersionId  String?

  segments TripSegment[]

  @@index([tripDate])
  @@index([fuelParameterVersionId])
  @@index([etcParameterVersionId])
  @@index([fuelPriceVersionId])
  @@index([fuelConsumptionVersionId])
}

// ── 行程段 ─────────────────────────────────────────────────────────
model TripSegment {
  id                  String            @id @default(cuid())
  travelApplicationId String
  travel              TravelApplication @relation(fields: [travelApplicationId], references: [applicationId], onDelete: Cascade)

  sortOrder   Int                           // 0..n-1，依提交陣列索引重寫（D15）
  origin      String?
  destination String?
  totalKm     Decimal? @db.Decimal(10, 2)   // D5：2 位小數（金額語意，須人類批准）
  highwayKm   Decimal? @db.Decimal(10, 2)

  // ── 段快照（完成時寫入，不可變）──
  snapshotFuelAmount Decimal? @db.Decimal(14, 4)  // 取整前
  snapshotEtcAmount  Decimal? @db.Decimal(14, 4)  // 取整前
  snapshotRawAmount  Decimal? @db.Decimal(14, 4)  // 取整前（油資+ETC）
  snapshotAmount     Int?                          // 取整後（整數）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([travelApplicationId, sortOrder])
}

// ---------------------------------------------------------------------------
// PHASE-006 models（§8.2；D3 批准之精度組）
// ---------------------------------------------------------------------------

// ── 保養子表（1:1） ─────────────────────────────────────────────────
model MaintenanceApplication {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  lastMaintenanceDate    DateTime? @db.Date
  currentMaintenanceDate DateTime? @db.Date
  lastOdometerKm         Decimal?  @db.Decimal(10, 2)
  currentOdometerKm      Decimal?  @db.Decimal(10, 2)
  actualCost             Decimal?  @db.Decimal(12, 2)

  // ── 完成快照（一經寫入不可變）──
  snapshotIntervalKm Decimal?  @db.Decimal(12, 2)
  snapshotOfficialKm Decimal?  @db.Decimal(12, 2)
  snapshotRatio      Decimal?  @db.Decimal(9, 6)
  snapshotRawAmount  Decimal?  @db.Decimal(14, 4)
  calculatedAt       DateTime?

  @@index([currentMaintenanceDate])
}

// ---------------------------------------------------------------------------
// PHASE-007 models（§8.2；D1(a) 子表、D2(a) applicationYear Int?、
// D3(a) 年度 [1900,2999] 之值域收斂於驗證層、D7(a) 快照 8 欄）
// ---------------------------------------------------------------------------

// ── 折舊子表（1:1） ─────────────────────────────────────────────────
model DepreciationApplication {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // ── 業務欄位（草稿可為 null；完成後不可變）──
  applicationYear Int? // 申請年度（西元年）；primaryDate 之來源（§16 D2）
  annualTotalKm   Decimal? @db.Decimal(9, 1) // 修訂段 §20.7.1：使用者申報之年度總里程（裁定①＋裁定 D）

  // ── 完成快照（BE-US-18 修訂後；9 欄）；一經寫入不可變 ──
  snapshotVehiclePrice           Decimal?  @db.Decimal(12, 2) // 車價（＝參數版本值）
  snapshotUsefulLifeYears        Int? // 折舊年限
  snapshotAnnualDepreciation     Decimal?  @db.Decimal(12, 2) // 修訂段 §20.7.1：每年折舊費用（2dp 來源值）
  snapshotOfficialKm             Decimal?  @db.Decimal(12, 2) // 年度公務里程
  snapshotAnnualTotalKm          Decimal?  @db.Decimal(9, 1) // 修訂段 §20.7.1：年度總里程快照＝新舊模型判別欄（§20.7.4）
  snapshotRatio                  Decimal?  @db.Decimal(9, 6) // 修訂段 §20.7.1：公務比例（比照保養）
  snapshotRawAmount              Decimal?  @db.Decimal(14, 4) // 取整前補貼金額
  calculatedAt                   DateTime?
  depreciationParameterVersionId String? // 引用保護來源（§16 D12）
  // 註：最終金額落於既有 `Application.totalAmount`（Int），不重複持久化。

  // ── 凍結唯讀（舊模型；新申請恆為 null，AC-55(b)）──
  snapshotEstimatedAnnualKm Int? // 預估年度行駛公里數（保留，不再寫入）
  snapshotPerKmUnitPrice    Decimal? @db.Decimal(14, 4) // 折舊每公里單價（保留，不再寫入；§8.3 容量缺口 #1）

  @@index([applicationYear])
  @@index([depreciationParameterVersionId])
}

// ---------------------------------------------------------------------------
// PHASE-008 models（§8.1；D1 單表裁定——applicationId 唯一為冪等鍵，
// FK onDelete: Restrict）
// ---------------------------------------------------------------------------

/// PHASE-008：正式報表（每個 Application 至多一份；修正版為新 Application → 新 Report）。
model Report {
  id            String      @id @default(cuid())
  applicationId String      @unique                       // 冪等鍵（D3）
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  reportNumber  String      @unique                       // "TRV-202608-0001"
  numberPrefix  String                                    // "TRV" | "MNT" | "DEP"
  numberPeriod  String                                    // "YYYYMM"（Asia/Taipei）
  sequence      Int                                       // 該 (prefix, period) 之序號，自 1

  storageKey    String      @unique                       // "rpt/<uuid>/pdf"（系統產生）
  fileName      String                                    // 產生時凍結之安全檔名（AC-23）
  byteSize      Int
  contentHash   String                                    // SHA-256 hex（重下一致性驗證）

  generatedById String                                    // 操作者（無 FK，沿 003a/005a 慣例）
  generatedAt   DateTime    @default(now())

  voidedFile VoidedReportFile? // PHASE-009：零 DDL 虛擬反向關聯（§8.2）

  @@unique([numberPrefix, numberPeriod, sequence])        // 併發最後防線（D3）
  @@index([numberPrefix, numberPeriod])                   // max(sequence) 查詢
}

// ---------------------------------------------------------------------------
// PHASE-009 models（§8.2；D4=b1 已裁定——作廢時同交易產生之「作廢版 PDF」）
// ---------------------------------------------------------------------------

/// PHASE-009：作廢版 PDF（每個 Report 至多一份；獨立表以維持 Report 零更新／刪除路徑之既有結構性守門）。
model VoidedReportFile {
  id          String   @id @default(cuid())
  reportId    String   @unique                            // 冪等鍵：一份 Report 至多一份作廢版
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Restrict)
  storageKey  String   @unique                            // "rpt/<uuid>/void"（系統產生）
  fileName    String                                       // 與原 Report.fileName 相同（編號不變）
  byteSize    Int
  contentHash String                                       // SHA-256 hex
  createdById String                                       // 作廢操作者（無 FK）
  createdAt   DateTime @default(now())
}
